rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products: anyone can read, only authenticated users/admins can create/edit/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Orders: anyone can create (for guest checkout), authenticated users can update
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null;
    }
    
    // Reviews: anyone can read and post reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Settings: anyone can read (WhatsApp number, banner, etc.), authenticated users can edit
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Counters: order numbering
    match /counters/{counterId} {
      allow read, write: if true;
    }
  }
}
