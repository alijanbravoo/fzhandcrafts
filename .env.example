# ==============================================================================
# Meta (Facebook) Pixel & Conversions API (CAPI) Configuration
# ==============================================================================
# Replace with your actual Pixel ID / Dataset ID from Meta Events Manager Settings
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Replace with your Conversions API Access Token (Generate in Meta Events Manager > Settings)
FACEBOOK_CAPI_ACCESS_TOKEN=

# Optional: Add your Test Event Code from Meta Events Manager > Test Events tab
# (Keep empty in production)
FACEBOOK_TEST_EVENT_CODE=

# ==============================================================================
# Optional Admin Access Configuration
# ==============================================================================
# Optional: Set a secret key to hide the /admin/login URL unless accessed via /admin/login?key=YOUR_SECRET_KEY
# (Leave blank or omit to allow standard direct access to /admin/login)
ADMIN_ACCESS_KEY=

# Optional: Additional comma-separated admin emails allowed to access /admin
NEXT_PUBLIC_ADMIN_EMAILS=
